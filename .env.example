# Copy to .env.local for local dev, or use .env.production for production builds
VITE_API_BASE_URL=http://localhost:5000/api

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# Must match backend GOOGLE_CLIENT_ID. Add your site origins under Authorized JavaScript origins.
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Optional: set on the backend (.env) for higher-quality auto-translate of CMS/API text
# GOOGLE_TRANSLATE_API_KEY=